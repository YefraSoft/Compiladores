# ---------------------------------------------------------------------------
# Este repositorio solo versiona codigo fuente de C++ y de Rust.
# Todo lo demas (binarios, artefactos de compilacion, proyectos de Visual
# Studio, respaldos .zip) queda fuera del control de versiones.
# ---------------------------------------------------------------------------

# Ignorar todo por defecto
*

# ...y volver a incluir unicamente el codigo fuente y la documentacion
!*.cpp
!*.h
!*.c
!**/*.cpp
!**/*.h
!**/*.c
!*.gitignore
!*.md

# Archivos de sistema de compilacion (Makefiles, CMake, Ninja)
!Makefile
!*.mk
!CMakeLists.txt
!**/Makefile
!**/*.mk
!**/CMakeLists.txt

# Codigo fuente de Rust y sus manifiestos (Cargo)
!*.rs
!**/*.rs
!Cargo.toml
!**/Cargo.toml
!Cargo.lock
!**/Cargo.lock
!rust-toolchain
!rust-toolchain.toml
!*.ron
!**/*.ron

# Necesario para poder re-incluir archivos dentro de carpetas ignoradas
!*/

# ---------------------------------------------------------------------------
# Salida de compilacion
# ---------------------------------------------------------------------------
build/
target/


# ---------------------------------------------------------------------------
# Reforzar exclusiones explicitas
# ---------------------------------------------------------------------------

# Artefactos de compilacion
*.exe
*.out
*.dll
*.so
*.a
*.lib
*.obj
*.o
*.pdb
*.ilk
*.idb
*.exp

# Resultados de compilacion de MSBuild / Visual Studio
*.tlog
*.recipe
*.log
x64/
Debug/
Release/
*.user

# Proyectos y soluciones de Visual Studio
*.sln
*.vcxproj
*.vcxproj.filters
*.vcproj
*.filters

# Respaldos comprimidos (el codigo ya vive en las carpetas de este repo)
*.zip
*.rar
*.7z
*.tar
*.gz

# Configuracion de editores / IDE
.vscode/
.idea/
*.swp
*~

# Sistema operativo
.DS_Store
Thumbs.db
